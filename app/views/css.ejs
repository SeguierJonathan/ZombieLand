<!DOCTYPE html>
<html lang="fr">

<head>
    <%- include('partials/head') %>

        <title>Zombieland</title>

        <link rel="stylesheet" href="./css/home.css">


</head>

<body>
    <%- include('partials/header') %>
        <%- include('partials/menu-slide') %>
            <%- include('partials/notifications') %>

                <main>
                    <section>
                        <fieldset class="flex--column">
                            <legend>Button</legend>
                            <div class="flex--row">
                                <button>Button</button>
                                <pre><code>&lt;button&gt;Buton&lt;/button&gt;</code></pre>
                            </div>
                            <div class="flex--row">
                                <button class="btn--validate">Buton</button>
                                <pre><code>&lt;button class="btn--validate"&gt;Bouton&lt;/button&gt;</code></pre>
                            </div>
                            <div class="flex--row">
                                <button class="btn-delete">Buton</button>
                                <pre><code>&lt;button class="btn-delete"&gt;Bouton&lt;/button&gt;</code></pre>
                            </div>
                            <div class="flex--row">
                                <button class="button-trans">Buton</button>
                                <pre><code>&lt;button class="button-trans"&gt;Buton&lt;/button&gt;</code></pre>
                            </div>
                            <div class="flex--row">
                                <button class="button-icon">Buton</button>
                                <pre><code>&lt;button class="button-icon"&gt;Buton&lt;/button&gt;</code></pre>
                            </div>
                            <div class="flex--row">
                                <button class="button-outline">Buton</button>
                                <pre><code>&lt;button class="button-outline"&gt;Buton&lt;/button&gt;</code></pre>
                            </div>
                            <div class="flex--row">
                                <button class="button">Buton</button>
                                <pre><code>&lt;button class="button"&gt;Buton&lt;/button&gt;</code></pre>
                            </div>
                        </fieldset>
                        <fieldset class="flex--column">
                            <legend>Card</legend>


                            <div class="flex--row">
                                <div class="card">
                                    <h2>ceci est une card</h2>
                                    <pre><code>class="card"</code></pre>
                                </div>
                            </div>
                            <div class="flex--row">
                                <div class="card--black">
                                    <h2>ceci est une card black</h2>
                                    <pre><code>class="card--black"</code></pre>
                                </div>
                            </div>
                            <div class="flex--row">
                                <div class="card-actions">
                                    <h2>ceci est une card actions</h2>
                                    <pre><code>class="card-actions"</code></pre>
                                </div>
                            </div>
                        </fieldset>
                        <fieldset class="flex--column">
                            <legend>link</legend>
                            <div class="flex--row">
                                <a href="#">ceci est un lien</a>
                                <pre><code>&lt;a&gt;Buton&lt;/a&gt;</code></pre>
                            </div>
                        </fieldset>
                        <fieldset class="flex--column">
                            <legend>Notification</legend>


                            <div class="flex--row">
                                <div class="notification show">
                                    <h2>ceci est une notification vierge</h2>
                                    <pre><code>class="notification"</code></pre>
                                </div>
                            </div>
                            <div class="flex--row">
                                <div class="notification success show">
                                    <h2>ceci est une notification success</h2>
                                    <pre><code>class="notification success"</code></pre>
                                </div>
                            </div>
                            <div class="flex--row">
                                <div class="notification warning show">
                                    <h2>ceci est une notification warning</h2>
                                    <pre><code>class="notification warning"</code></pre>
                                </div>
                            </div>
                            <div class="flex--row">
                                <div class="notification error show">
                                    <h2>ceci est une notification error</h2>
                                    <pre><code>class="notification"</code></pre>
                                </div>
                            </div>
                            <div class="flex--row">
                                <div class="notification info show">
                                    <h2>ceci est une notification info</h2>
                                    <pre><code>class="notification"</code></pre>
                                </div>
                            </div>

                        </fieldset>


                    </section>


                </main>
                <%- include('partials/footer') %>
</body>

</html>