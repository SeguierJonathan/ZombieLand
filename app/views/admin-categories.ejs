<!DOCTYPE html>
<html lang="fr">

<head>
    <%- include("partials/head") %>

        <title>Zombieland - Utilisateurs</title>
        <link rel="stylesheet" href="/css/admin-categories.css" />
        <script defer src="/js/common.js"></script>
        <script defer src="/js/modal.js"></script>

</head>

<body>
    <%- include("partials/header") %>
        <%- include("partials/menu-slide") %>
            <%- include("partials/notifications") %>

                <%- include("partials/modal", { id: "createCategory" , body: include("partials/modalTemplate/categorie")
                    }) %>

                    <main>
                        <section>
                            <h2>Liste des Categories</h2>
                            <button onclick="modal.open('createCategory')">ajouter</button>

                            <% if (categories && categories.length> 0) { %>
                                <div class="categories-grid">
                                    <% categories.forEach((categorie)=> { %>
                                        <div class="card--black js-editable">
                                            <form action="/admin/categories/<%= categorie.id %>/update" method="POST">

                                                <p><strong>Nom :</strong>
                                                    <span class="view-mode">
                                                        <%= categorie.name %>
                                                    </span>
                                                    <input class="edit-mode" type="text" name="name"
                                                        value="<%= categorie.name %>" hidden>
                                                </p>
                                                <p><strong>Description :</strong>
                                                    <span class="view-mode">
                                                        <%= categorie.description %>
                                                    </span>
                                                    <textarea class="edit-mode" name="description"
                                                        value="<%= categorie.description %>" hidden></textarea>
                                                </p>

                                                <button type="button" class="btn--update" onclick="toggleEdit(this)">
                                                    Modifier
                                                </button>
                                                <button type="submit" class="btn--save" hidden>
                                                    Enregistrer
                                                </button>
                                            </form>

                                            <form action="/admin/categories/<%= categorie.id %>/delete" method="POST"
                                                onsubmit="return confirm('Suppprimer cet categories ?');">
                                                <button type="subit" class="btn-delete">Supprimer</button>
                                            </form>

                                        </div>


                                        <% }); %>
                                </div>
                                <% } else { %>
                                    <p>Liste des Categories indisponible 😢</p>
                                    <% } %>
                        </section>
                    </main>

                    <%- include("partials/footer") %>
</body>

</html>