<!DOCTYPE html>
<html lang="fr">

<head>
    <%- include('partials/head') %>

        <title>Zombieland | Inscription</title>
        <link rel="stylesheet" href="./css/pages/auth.css">

</head>

<body>
    <%- include('partials/header') %>
        <%- include('partials/menu-slide') %>
            <%- include('partials/notifications') %>

                <main>

                    <h2>Inscription</h2>

                    <form method="post">

                        <div>
                            <label for="lastName">Nom</label>
                            <input id="lastName" type="lastName" name="lastName" placeholder="Nom" required>
                        </div>

                        <div>
                            <label for="firstName">Prénom</label>
                            <input id="firstName" type="firstName" name="firstName" placeholder="Prénom" required>
                        </div>
                        <div>
                            <label for="email">E-mail</label>
                            <input id="email" type="email" name="email" placeholder="Saisissez votre email..." required>
                        </div>

                        <div>
                            <label for="password">Mot de passe</label>
                            <input id="password" type="password" name="password" placeholder="Votre mot de passe"
                                required>
                        </div>

                        <div>
                            <label for="confirmPassword">Confirmer le mot de passe</label>
                            <input id="confirmPassword" type="password" name="confirmPassword"
                                placeholder="Confirmer votre mot de passe" required>
                        </div>

                        <button type="submit">Créer le compte</button>

                        <p>Déjà inscrit&nbsp;? <a href="/connexion">Se connecter</a></p>

                    </form>

                </main>
                <%- include('partials/footer') %>
</body>

</html>