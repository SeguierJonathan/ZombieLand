<!DOCTYPE html>
<html lang="fr">

<head>
    <%- include('partials/head') %>
        <title>Zombieland - Mon compte</title>
        <link rel="stylesheet" href="/css/pages/account.css">
</head>

<body>

    <%- include('partials/header') %>
        <%- include('partials/menu-slide') %>
            <%- include('partials/notifications') %>

                <main>
                    <h2 class="text-center">Mon compte</h2>

                    <form class="form--profil" action="/mon-compte" method="POST">
                        <div class="flex-row gap-2">
                            <fieldset class="flex-column flex-1">
                                <legend>info personnel</legend>

                                <div class="flex-column">
                                    <label for="firstName">Prénom :</label>
                                    <input type="text" name="firstName" value="<%= user.firstName %>">
                                </div>

                                <div class="flex-column">
                                    <label for="lastName">Nom :</label>
                                    <input type="text" name="lastName" value="<%= user.lastName %>">
                                </div>

                                <div class="flex-column">
                                    <label for="email">Email :</label>
                                    <input type="email" name="email" value="<%= user.email %>">
                                </div>
                            </fieldset>
                            <div class="flex-1">
                                <fieldset>
                                    <legend>Sécurité</legend>
                                    <div class="flex-column">
                                        <label for="password">Mot de passe actuel</label>
                                        <input type="password" id="password" name="password"
                                            placeholder="Votre Ancien mot de passe" required>
                                    </div>
                                </fieldset>

                                <fieldset class="flex-column flex-1">
                                    <legend>Changer mot de passe</legend>

                                    <div class="flex-column">
                                        <label for="newPassword">Nouveau mot de passe</label>
                                        <input type="password" id="newPassword" placeholder="Votre mot de passe"
                                            name="newPassword">
                                    </div>

                                    <div class="flex-column">
                                        <label for="confirmPassword">Confirmer le mot de passe</label>
                                        <input type="password" id="confirmPassword" name="confirmPassword"
                                            placeholder="Confirmer votre mot de passe">
                                    </div>
                                </fieldset>
                            </div>
                        </div>

                        <div>
                            <button type="submit">Modifier</button>
                            <button>
                                Supprimer mon compte
                            </button>

                        </div>

                        <button class="btn--link" type="submit" form="submitLougout" class="link-btn">
                            Me déconnecter
                        </button>


                    </form>

                    <form id="submitLougout" action="/auth/logout" method="POST">

                    </form>


                </main>

                <%- include('partials/footer') %>


</body>

</html>