<!DOCTYPE html>
<html lang="fr">

<head>
    <%- include('partials/head') %>

        <title>Zombieland | Liste des activités</title>

        <meta name="description" content="Liste des activités proposées par le parc Zombieland.">

        <link rel="stylesheet" href="/css/activity.css">
        <script defer src="/js/catActivity.js"></script>
</head>

<body>
    <%- include('partials/header') %>
        <%- include('partials/menu-slide') %>
            <%- include('partials/notifications') %>
                <main>

                    <h2>Liste des activités</h2>

                    <form id="categoryForm">

                        <select id="categorySelect" onchange="redirectToCategory(this.value)">

                            <option value="">-- Toutes les categories --</option>

                            <% categories.forEach(category=> { %>
                                <option value="<%= category.id %>" <%=(typeof categoryId !=='undefined' &&
                                    categoryId==category.id) ? 'selected' : '' %> >
                                    <%= category.name %>
                                </option>
                                <% }) %>

                        </select>
                    </form>

                    <section>
                        <% activities.forEach(activity=> { %>
                            <article>
                                <h3>
                                    <%= activity.name %>
                                </h3>
                                <p><img src="/img/<%= activity.image %>" alt="Image de l'activitée selectionnée"></p>

                                <a href="/activites/<%= activity.id %>" class="button">Voir détails</a>
                            </article>
                            <% }) %>
                    </section>
                </main>
                <%- include('partials/footer') %>

</body>

</html>