<!DOCTYPE html>
<html lang="fr">

<head>
    <%- include('partials/head') %>

        <title>Zombieland</title>
        <link rel="stylesheet" href="/css/activity.css">
        <script defer src="/js/catActivity.js"></script>
</head>

<body>
    <%- include('partials/header') %>
        <main>

            <h2>Liste des activités</h2>

            <form id="categoryForm">
                <select name="id" onchange="submitForm()" id="">
                    <option value="">--Veuillez choisir une catégorie--</option>
                    <% categories.forEach(category=> { %>
                        <option value="<%= category.id %>">
                            <%= category.name %>
                        </option>
                        <% }) %>
                </select>
            </form>

            <section>
                <% activities.forEach(activity=> { %>
                    <article>
                        <h3>
                            <%= activity.name %>
                        </h3>
                        <p><img src="/img/<%= activity.image %>" alt="Image de l'activitée selectionnée"></p>

                        <a href="/activites/<%= activity.id %>" class="button">Voir détails</a>
                    </article>
                    <% }) %>
            </section>
        </main>
        <%- include('partials/footer') %>

</body>

</html>