<% if(locals.notifications?.length){%>
    <div id="notifications">
        <% notifications.forEach(notification=> { %>

            <div class="notification <%= notification.type%>" role="alert" aria-hidden="true">
                <p>
                    <%=notification.message%>
                </p>
            </div>

            <% }); %>
    </div>
    <% } %>