<div id="mobile-menu">

    <div class="header-menu">

        <div class="greeting">
            <%if(!firstName){%>
                <a class="button" href="/connexion">Se connecter</a>
                <%}else{%>
                    <a href="/mon-compte">Bonjour, <span>
                            <%= firstName%>
                        </span></a>
                    <a href="/auth/logout">Se déconnecter</a>
                    <%}%>
        </div>
        <button id="close-button" class="button-icon" aria-label="Fermer le menu">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24">
                <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M5 5l7 7l7 -7M12 12h0M5 19l7 -7l7 7">
                    <animate fill="freeze" attributeName="d" dur="0.4s"
                        values="M5 5l7 0l7 0M5 12h14M5 19l7 0l7 0;M5 5l7 7l7 -7M12 12h0M5 19l7 -7l7 7" />
                </path>
            </svg>
        </button>
    </div>

    <ul>
        <li><a class="button" href="/reservation">Réserver</a></li>
        <%if(firstName){%>
            <li><a class="button" href="/mes-reservations">Mes réservations</a></li>
            <%}%>
                <li><a class="button" href="/activites">Activités</a></li>
                <li><a class="button" href="/plan">Plan du parc</a></li>
                <li><a class="button" href="/information">Information</a></li>
                <li><a class="button" href="/a-propos">A propos</a></li>
    </ul>

    <p class="menu-footer">© 2026 Studio</p>
