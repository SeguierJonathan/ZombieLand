<!DOCTYPE html>
<html lang="fr">
  <head>
    <%- include('partials/head') %>

    <title>Zombieland - Informations</title>

    <link rel="stylesheet" href="./css/home.css" />
  </head>

  <body>
    <%- include('partials/header') %> <%- include('partials/menu-slide') %>

    <main>
      <section id="horaires">
        <h2>🕒 Horaires d'ouverture</h2>

        <h3>Haute Saison (Juin - Septembre)</h3>
        <p>Lundi - Dimanche : 10h00 - 00h00</p>

        <h3>Basse Saison (Octobre - Mai)</h3>
        <p>Mardi - Dimanche : 11h00 - 22h00</p>
        <p>Fermé Lundi</p>
      </section>

      <section id="tarifs">
        <h2>🎟️ Nos Tarifs</h2>
        <p><strong>Prix à l'année :</strong> 30€</p>
      </section>

      <section id="meteo">
  <h2>🌤️ Météo du Parc</h2>

  <% if (meteo) { %>
    <div class="meteo-card">
      <h3><%= meteo.ville %></h3>
      <img src="<%= meteo.iconeUrl %>" alt="<%= meteo.description %>">
      <p>🌡️ Température actuelle : <%= meteo.temperature %>°C / Ressenti : <%= meteo.ressentie %>°C</p>
      <p>💧 Humidité : <%= meteo.humidite %>%</p>
      <p>💨 Vent : <%= meteo.vent %> km/h</p>
    </div>
  <% } else { %>
    <p>Météo temporairement indisponible. 😢</p>
  <% } %>

</section>

      <section id="acces">
        <h2>🗺️ Comment venir ?</h2>
        <!-- Intégration Google Maps -->
      </section>
    </main>
    <%- include('partials/footer') %>
  </body>
</html>
