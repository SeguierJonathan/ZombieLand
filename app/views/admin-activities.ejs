<!DOCTYPE html>
<html lang="fr">

<head>
    <%- include('partials/head') %>

        <title>Zombieland</title>
        <link rel="stylesheet" href="/css/activity.css">
</head>

<body>
    <%- include('partials/header') %>
        <%- include('partials/menu-slide') %>
            <%- include('partials/notifications') %>
                <main>

                    <h2>Liste des activités</h2>

                    <section>
                        <% activities.forEach(activity=> { %>
                            <article>
                                <h3>
                                    <%= activity.name %>
                                </h3>
                                <p><img src="/img/<%= activity.image %>" alt="Image de l'activitée selectionnée"></p>

                                <a href="/menu-administrateur/activites/<%= activity.id %>" class="button">Voir détails</a>
                                <form action="/menu-administrateur/activites/<%= activity.id %>/delete" method="post">
                                    <button type="submit">
                                        Supprimer l'activité
                                    </button>
                                </form>
                            </article>
                            <% }) %>
                    </section>
                </main>
                <%- include('partials/footer') %>

</body>

</html>