<!DOCTYPE html>
<html lang="fr">

<head>
    <%- include('partials/head') %>

        <title>Zombieland</title>
        <link rel="stylesheet" href="./css/activity.css">
</head>

<body>
    <%- include('partials/header') %>
        <main>

            <h2>Détails de l'activité</h2>

            <article>
                <h3>
                    <%= activity.name %>
                </h3>
                <p><img src="img/<%= activity.image %>" alt="Image de l'activitée selectionnée"></p>
                <p>
                    <%= activity.minHeightCM %>
                </p>
                <p>
                    <%= activity.horrorLevel %>
                </p>
                <p>
                    <%= activity.durationSeconds %>
                </p>
                <p>
                    <%= activity.description %>
                </p>

                <a href="/activites" class="button">Retour à la liste des activitées</a>
            </article>

        </main>
        <%- include('partials/footer') %>

</body>

</html>