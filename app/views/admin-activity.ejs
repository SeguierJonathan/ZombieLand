<!DOCTYPE html>
<html lang="fr">

<head>
    <%- include('partials/head') %>

        <title>Zombieland</title>
        <link rel="stylesheet" href="/css/activity.css">
        <script defer src="/js/common.js"></script>


</head>

<body>
    <%- include('partials/header') %>
        <%- include('partials/menu-slide') %>
            <%- include('partials/notifications') %>
                <main>

                    <h2>Détails de l'activité</h2>

                    <article class="card--black js-editable">
                        <form action="/admin/activities/<%= activity.id %>/update" method="POST">

                            <div>
                                <p>
                                <h3>
                                    <%= activity.name %>
                                </h3>
                                <input class="edit-mode" type="text" name="name" id="name" value="<%= activity.name %>"
                                    hidden>
                                </p>


                                <p>
                                    <img src="/img/<%= activity.image %>" alt="Image de l'activitée selectionnée">
                                    <input class="edit-mode" type="text" name="image" id="image"
                                        value="<%= activity.image %>" hidden>
                                </p>

                                <p>
                                    <strong>Taille minimum obligatoire : </strong>
                                    <%= activity.minHeightCM %>
                                        <input class="edit-mode" type="number" name="minHeightCM" id="minHeightCM"
                                            value="<%= activity.minHeightCM %>" hidden>
                                </p>

                                <p>
                                    <strong>Niveau d'horreur : </strong>
                                    <%= activity.horrorLevel %>
                                        <input class="edit-mode" type="number" name="horrorLevel" id="horrorLevel"
                                            value="<%= activity.horrorLevel %>" hidden>
                                </p>

                                <p>
                                    <strong>Durée : </strong>
                                    <%= activity.durationSeconds %>
                                        <input class="edit-mode" type="number" name="durationSeconds"
                                            id="durationSeconds" value="<%= activity.durationSeconds %>" hidden>
                                </p>

                                <p>
                                    <strong>Description : </strong>
                                    <%= activity.description %>
                                        <input class="edit-mode" type="text" name="description" id="description"
                                            value="<%= activity.description %>" hidden>
                                </p>

                                <p>
                                    <label for="activityCatégory">Catégorie: <%= activity.category.name %> </label>
                                    <select class="edit-mode" id="categorySelectAdmin" name="categoryId" hidden>

                                        <% categories.forEach(category=> { %>
                                            <option value="<%= category.id %>">
                                                <%= category.name %>
                                            </option>
                                            <% }) %>

                                    </select>
                                </p>

                            </div>

                            <button type="button" class="btn--update" onclick="toggleEdit(this)">
                                Modifier
                            </button>
                            <button type="submit" class="btn--save" hidden>
                                Enregistrer
                            </button>

                        </form>

                        <a href="/menu-administrateur/activites" class="button">Retour à la liste des activitées</a>

                        <form action="/admin/activities/<%= activity.id %>/delete" method="post">
                            <button type="submit"
                                onclick="return confirm('Voulez-vous vraiment supprimer cette activité ?')">
                                Supprimer l'activité
                            </button>
                        </form>

                    </article>


                </main>
                <%- include('partials/footer') %>

</body>

</html>